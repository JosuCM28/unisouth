# ── Neon PostgreSQL ──────────────────────────────────────────────────────
# Cadena CON -pooler: la que usa la app en runtime.
DATABASE_URL=""
# La MISMA cadena pero SIN -pooler. Prisma la necesita para migraciones,
# porque el pooler de Neon no las soporta.
DIRECT_URL=""

# ── BetterAuth ───────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── App ──────────────────────────────────────────────────────────────────
# Base del QR de cada rollo: {NEXT_PUBLIC_APP_URL}/r/{code}
NEXT_PUBLIC_APP_URL="http://localhost:3000"
