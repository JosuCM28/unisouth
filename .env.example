# ── Base de datos ────────────────────────────────────────────────────────
#
# OPCIÓN A — Postgres dentro de Dokploy (mismo VPS)
#
#   El host es el NOMBRE DEL SERVICIO en la red interna de Docker, no
#   "localhost": desde el contenedor de la app, localhost es él mismo.
#   Dokploy muestra ese nombre en la pestaña del servicio de base de datos.
#
#   No lleva sslmode: el tráfico no sale del host, va por la red interna.
#   Ambas variables son IDÉNTICAS: sin pooler no hay dos endpoints.
#
#   DATABASE_URL="postgresql://usuario:password@unisouth-db:5432/unisouth"
#   DIRECT_URL="postgresql://usuario:password@unisouth-db:5432/unisouth"
#
# OPCIÓN B — Neon (gestionado)
#
#   Aquí sí hay dos endpoints: el pooled para runtime y el directo para
#   migraciones, porque el pooler de Neon no las soporta.
#
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require&channel_binding=require"
#   DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require"
#
DATABASE_URL=""
DIRECT_URL=""

# ── BetterAuth ───────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
# Mínimo 32 caracteres: BetterAuth se niega a arrancar con menos.
BETTER_AUTH_SECRET=""

# En producción DEBE ser https. La cookie de sesión va con `secure`, así que
# con http el navegador no la guarda y nadie puede iniciar sesión.
BETTER_AUTH_URL="http://localhost:3000"

# ── App ──────────────────────────────────────────────────────────────────
# Base del QR de cada rollo: {NEXT_PUBLIC_APP_URL}/r/{code}
#
# OJO: además de variable de entorno, va como BUILD ARG en Dokploy. Se hornea
# en el bundle del cliente al compilar; si falta, los QR apuntan a
# "undefined/r/R-2026-00841".
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Zona horaria de la fábrica. Las fechas se GUARDAN en UTC y sólo se traducen
# a esta zona al mostrarlas. Sin ella, el servidor (que corre en UTC) fechaba
# al día siguiente todo lo capturado después de las 6 de la tarde.
NEXT_PUBLIC_APP_TIMEZONE="America/Mexico_City"
