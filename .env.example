# ── Base de datos ────────────────────────────────────────────────────────
# PostgreSQL en el mismo VPS. Las DOS variables llevan la MISMA cadena.
#
# Desde fuera del VPS (desarrollo), con la IP y el puerto publicado:
#
#   DATABASE_URL="postgresql://usuario:password@IP_DEL_VPS:5438/unisouthdb"
#   DIRECT_URL="postgresql://usuario:password@IP_DEL_VPS:5438/unisouthdb"
#
# Desde el contenedor de la app, con el NOMBRE DEL SERVICIO en la red interna
# de Docker —no "localhost", que desde ahí dentro es el contenedor mismo—.
# Dokploy muestra ese nombre en la pestaña del servicio de base de datos:
#
#   DATABASE_URL="postgresql://usuario:password@unisouth-db:5432/unisouthdb"
#   DIRECT_URL="postgresql://usuario:password@unisouth-db:5432/unisouthdb"
#
# Por la red interna no lleva sslmode: el tráfico no sale del host.
#
# Por qué dos variables si son idénticas: DIRECT_URL es la que usan las
# MIGRACIONES, que corren al arrancar el contenedor. Hoy da igual porque se
# conecta directo, pero un pooler (PgBouncer y compañía) no soporta
# migraciones, así que el día que se meta uno, ésta es la que lo esquiva.
DATABASE_URL=""
DIRECT_URL=""

# ── BetterAuth ───────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 32
# Mínimo 32 caracteres: BetterAuth se niega a arrancar con menos.
BETTER_AUTH_SECRET=""

# En producción DEBE ser https. La cookie de sesión va con `secure`, así que
# con http el navegador no la guarda y nadie puede iniciar sesión.
BETTER_AUTH_URL="http://localhost:3000"

# ── App ──────────────────────────────────────────────────────────────────
# Base del QR de cada rollo: {NEXT_PUBLIC_APP_URL}/r/{code}
#
# OJO: además de variable de entorno, va como BUILD ARG en Dokploy. Se hornea
# en el bundle del cliente al compilar; si falta, los QR apuntan a
# "undefined/r/R-2026-00841".
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Zona horaria de la fábrica. Las fechas se GUARDAN en UTC y sólo se traducen
# a esta zona al mostrarlas. Sin ella, el servidor (que corre en UTC) fechaba
# al día siguiente todo lo capturado después de las 6 de la tarde.
NEXT_PUBLIC_APP_TIMEZONE="America/Mexico_City"

# ── Fotos de las órdenes ─────────────────────────────────────────────────
# Carpeta donde se guardan los respaldos fotográficos de los papeles de cada
# orden. En producción es la ruta del volumen montado en el contenedor; en
# local, una carpeta del proyecto que va en .gitignore.
#
# Si el volumen NO está montado, la app sigue aceptando fotos y el siguiente
# despliegue se las lleva. Por eso avisa en pantalla cuando no puede escribir.
UPLOADS_DIR=".uploads"

# ── WhatsApp (Evolution API v2) ─────────────────────────────────────────────
# Para mandar el PDF de cada salida al aplicarla. Las TRES son necesarias; si
# falta alguna, la app funciona igual y sólo deja de ofrecer el envío.
#
# EVOLUTION_API_URL: la raíz del servidor de Evolution, sin diagonal final.
# EVOLUTION_API_KEY: la apikey global del servidor o la de la instancia.
# EVOLUTION_INSTANCE: el nombre de la instancia donde se vinculó el celular
#                     (se crea en el manager de Evolution y se escanea su QR).
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""